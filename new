<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Modern Dark Login</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: #f8fafc;
    }

    .login-card {
      background: #1e293b;
      padding: 2.5rem;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
      border: 1px solid #334155;
      width: 100%;
      max-width: 400px;
    }

    .login-card h2 {
      text-align: center;
      margin-bottom: 0.5rem;
      font-size: 1.75rem;
    }

    .subtitle {
      text-align: center;
      color: #94a3b8;
      font-size: 0.9rem;
      margin-bottom: 1.75rem;
    }

    .input-group {
      margin-bottom: 1.25rem;
      position: relative;
    }

    .input-group label {
      display: block;
      margin-bottom: 0.4rem;
      font-size: 0.85rem;
      color: #cbd5e1;
    }

    .input-group input {
      width: 100%;
      padding: 0.75rem;
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 8px;
      color: #f8fafc;
      font-size: 1rem;
      transition: border-color 0.2s;
    }

    .input-group input:focus {
      outline: none;
      border-color: #38bdf8;
    }

    .toggle-password {
      position: absolute;
      right: 12px;
      top: 34px;
      background: none;
      border: none;
      color: #94a3b8;
      font-size: 0.8rem;
      cursor: pointer;
    }

    .toggle-password:hover {
      color: #f8fafc;
    }

    .options {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
      color: #94a3b8;
    }

    .options a {
      color: #38bdf8;
      text-decoration: none;
    }

    .options a:hover {
      text-decoration: underline;
    }

    .login-btn {
      width: 100%;
      padding: 0.8rem;
      background: #38bdf8;
      border: none;
      border-radius: 8px;
      color: #0f172a;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s;
    }

    .login-btn:hover {
      background: #0ea5e9;
    }

    .status-msg {
      margin-top: 1rem;
      text-align: center;
      font-size: 0.85rem;
      min-height: 1.2rem;
    }

    .signup-link {
      text-align: center;
      margin-top: 1.25rem;
      font-size: 0.9rem;
      color: #94a3b8;
    }

    .signup-link a {
      color: #38bdf8;
      text-decoration: none;
      font-weight: 600;
    }
  </style>
</head>
<body>

  <div class="login-card">
    <h2>Welcome Back</h2>
    <p class="subtitle">Please enter your details to sign in</p>

    <form id="loginForm">
      <div class="input-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" placeholder="you@example.com" required>
      </div>

      <div class="input-group">
        <label for="password">Password</label>
        <input type="password" id="password" placeholder="••••••••" required>
        <button type="button" class="toggle-password" id="toggleBtn">Show</button>
      </div>

      <div class="options">
        <label>
          <input type="checkbox" id="remember"> Remember me
        </label>
        <a href="#">Forgot password?</a>
      </div>

      <button type="submit" class="login-btn">Sign In</button>
      <p class="status-msg" id="statusMsg"></p>
    </form>

    <div class="signup-link">
      Don't have an account? <a href="#">Create one</a>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById('toggleBtn');
    const passwordInput = document.getElementById('password');
    const loginForm = document.getElementById('loginForm');
    const statusMsg = document.getElementById('statusMsg');

    // Show/Hide Password Toggle
    toggleBtn.addEventListener('click', () => {
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
      toggleBtn.textContent = isPassword ? 'Hide' : 'Show';
    });

    // Basic Form Submission Handling
    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value;
      
      if (passwordInput.value.length < 6) {
        statusMsg.style.color = '#f87171';
        statusMsg.textContent = 'Password must be at least 6 characters.';
        return;
      }

      statusMsg.style.color = '#4ade80';
      statusMsg.textContent = `Logging in as ${email}...`;
    });
  </script>

</body>
</html>
